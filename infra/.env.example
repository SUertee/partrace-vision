# Copy to .env on the server and restrict permissions: chmod 600 .env.
# Generate each password independently using: openssl rand -hex 32
# Keep passwords URL-safe (letters, digits, underscores or hyphens; 32+ characters).
# Never commit .env or print `docker compose config` with real credentials.
POSTGRES_DB=partrace
POSTGRES_USER=partrace_admin
POSTGRES_PASSWORD=
PARTRACE_DATABASE_USER=partrace_app
PARTRACE_DATABASE_PASSWORD=
PARTRACE_ENVIRONMENT=staging
PARTRACE_API_PORT=8000

# Optional Agent. Keep one API worker; model and embedding keys stay server-side.
PARTRACE_AGENT_ENABLED=false
PARTRACE_AGENT_MODEL=
PARTRACE_AGENT_MODEL_VERSION=v1
PARTRACE_AGENT_API_KEY=
PARTRACE_AGENT_BASE_URL=
PARTRACE_EMBEDDING_MODEL=
PARTRACE_EMBEDDING_MODEL_VERSION=v1
PARTRACE_EMBEDDING_DIMENSIONS=
PARTRACE_EMBEDDING_API_KEY=
PARTRACE_EMBEDDING_BASE_URL=

# These credentials initialize an EMPTY PostgreSQL volume only.
# Changing .env does not rotate an existing database user's password.
