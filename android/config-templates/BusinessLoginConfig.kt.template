  object EnvQA {
    const val REGION = "US"
    const val APP_NAME = "forqa"
    const val CLIENT_ID = "openapi_client_forqa"
    const val CLIENT_SECRET = ""
    const val USER_ID = ""
    const val TOKEN = ""
    const val APP_DOMAIN = "https://openapi-qa.eufylife.com/"
    const val DEVICE_DOMAIN = "https://security-app-qa.eufylife.com"
