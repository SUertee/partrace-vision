# setup-local.py creates backend/.env with the local DB and private paths.
# Add the following optional settings to that file; never commit real keys.
PARTRACE_AGENT_ENABLED=true
PARTRACE_AGENT_MODEL=
PARTRACE_AGENT_MODEL_VERSION=v1
PARTRACE_AGENT_API_KEY=
# Empty URL uses the official OpenAI endpoint. For compatible providers include /v1 if required.
PARTRACE_AGENT_BASE_URL=
PARTRACE_AGENT_TIMEOUT_SECONDS=60
PARTRACE_AGENT_MAX_CONCURRENT_RUNS=2
PARTRACE_AGENT_MODEL_CALLS=8
PARTRACE_AGENT_TOOL_CALLS=12

# Optional text encoder. Its exact model/version/dimensions must match stored vectors.
# Changing models requires a new version and re-indexing; no automatic fake vectors.
PARTRACE_EMBEDDING_MODEL=
PARTRACE_EMBEDDING_MODEL_VERSION=v1
PARTRACE_EMBEDDING_DIMENSIONS=
PARTRACE_EMBEDDING_API_KEY=
PARTRACE_EMBEDDING_BASE_URL=
PARTRACE_EMBEDDING_TIMEOUT_SECONDS=20
