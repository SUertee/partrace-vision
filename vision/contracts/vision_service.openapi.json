  "components": {
    "schemas": {
      "ARecordingNotice": {
        "properties": {
          "recording_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Recording Id"
          },
          "camera_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Camera Id"
          },
          "left2right_flag": {
            "type": "boolean",
            "title": "Left2Right Flag",
            "description": "true: 左到右enter_zone，右到左leave_zone；false反之。无需分界线。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recording_id",
          "camera_id",
          "left2right_flag"
        ],
        "title": "ARecordingNotice"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobAccepted": {
        "properties": {
          "created": {
            "type": "boolean",
            "title": "Created"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "depends_on_a_jobs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Depends On A Jobs"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          }
        },
        "type": "object",
        "required": [
          "created",
          "job_id",
          "status",
          "depends_on_a_jobs",
          "status_url"
        ],
        "title": "JobAccepted"
      },
      "RecordingNotice": {
        "properties": {
          "recording_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Recording Id"
          },
          "camera_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Camera Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recording_id",
          "camera_id"
        ],
        "title": "RecordingNotice"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
